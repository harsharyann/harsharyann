# ── ENVIRONMENT CONFIGURATION TEMPLATE ──
# Rename this file to .env.local on your local machine and replace with your private values.
# NEVER commit your real .env.local file to GitHub.

# Google Sheets API endpoint for contact inquiries
NEXT_PUBLIC_GOOGLE_SHEET_URL=your_google_apps_script_exec_url_here

# ── SOCIUS ADMIN VAULT SECURITY CREDENTIALS ──
# Custom Admin Credentials (Required for accessing the admin panel)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_super_strong_password_here
ADMIN_PIN=123456
ADMIN_GATE_KEY=your_secret_url_gate_key
ADMIN_SECRET_KEY=generate_a_random_32_character_secret_string_here
